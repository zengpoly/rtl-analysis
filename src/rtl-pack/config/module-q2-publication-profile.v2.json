  "publication": {
    "global_gates": [
      "candidate is exact approved v0.2 identity",
      "scope and build/source revision match",
      "each factual claim has direct current in-scope Source Evidence with frozen Stage1 file SHA-256 and matching normalized UTF-8 span SHA-256",
      "VERIFIED review from the controlled independent-review provenance path matches complete input binding",
      "all present Fact links have reviewed quality EXACT, PARTIAL or SCOPE_ONLY and correspond to actual field content; SCOPE_ONLY never counts as content",
      "claim and coverage applicability remain nonempty and downward-only",
      "ownership and each published bounded claim's own semantics are resolved and supported"
    ],
    "idempotence": "Same ai_id plus identical complete authoritative claims, support, Source, review, coverage and lifecycle is idempotent; any difference conflicts",
    "read_consistency": "A later reader takes one SQLite read transaction snapshot, checks every CURRENT coverage member is CURRENT, and projects claims and coverage from that snapshot; no mixed pre/post-commit view",
    "replacement": "Under write lock, stale every CURRENT coverage referring to a claim made STALE, including coverage outside the incoming overlay; otherwise reject atomically",
    "review_binding": {
      "behavior": [
        "type/key/target",
        "ownership mode and owner",
        "applicability",
        "participants/related subjects when present"
      ],
      "candidate": [
        "schema and contract version",
        "build/source revision and closure digests",
        "scope ID and canonical envelope digest"
      ],
      "claim_set_digest": "SHA-256 of the canonical JSON array of sorted unique claim member IDs",
      "claims": [
        "AI ID and target/key/type/text/shape",
        "all structured fields/applicability/limitations",
        "each Fact ID, quality and field-level content relation",
        "each direct Source Evidence ID/path/span/file SHA-256/normalized span SHA-256/current identity"
      ],
      "comparison": "Writer reconstructs each batch from authoritative candidate rows, pinned Profile bytes and complete I; changed batch input or digest rejects before publication.",
      "contract": [
        "profile id/version",
        "vocabulary id/version",
        "canonical contract-object SHA-256; complete I separately binds the raw Profile file SHA-256"
      ],
      "coverage": [
        "each exact target/obligation/contract identity",
        "sorted claim members and digest",
        "applicability/status/limitations/conflicts/unresolved findings"
      ],
      "excluded_from_input": [
        "review artifact ID/status/reviewer identity/signature/path",
        "review input digest itself",
        "mutable row lifecycle/validity and receipt"
      ],
      "required_top_level": [
        "schema",
        "contract",
        "candidate",
        "behavior",
        "claims",
        "coverage"
      ],
      "schema": "rtl-analysis-agent/publication-review-input-v1",
      "serialization": "UTF-8 JSON, sorted object keys, no insignificant whitespace, ensure_ascii=false; sets represented by sorted unique arrays; ordered semantic lists preserve declared order; SHA-256 over exactly this input object"
    },
    "review_trust": "Complete I excludes review and lists all 12 dispositions, batches and Source intake. An independent R cites H(I); Human A cites H(I), H(R), Profile, intake, candidate and batch set. The writer requires an externally pinned H(A), rechecks canonical I/R/A artifacts and source identities, and stores exact review input in provenance Evidence. Names or an overlay VERIFIED flag alone never establish authority. Process trust does not resist an attacker holding the same GitHub write credentials.",
    "source_only_publication_gate": "Current direct Source, inference basis, applicability, limitations, and independent review permit PUBLISHED without content Fact; source-only READY is denied by all v1 obligations.",
    "source_only_ready_gate": "All five v1 obligations set source_only_ready=false. Source-only publication remains PARTIAL or GAP.",
    "writer": "PrototypeStore.publish_reviewed_semantic_overlay through the bounded q2-publish CLI adapter; one approved target batch per transaction."
  },
