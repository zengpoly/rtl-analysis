  "publication": {
    "global_gates": [
      "candidate is exact approved v0.2 identity",
      "scope and build/source revision match",
      "each factual claim has direct current in-scope Source Evidence with frozen Stage1 file SHA-256 and matching normalized UTF-8 span SHA-256",
      "VERIFIED review from the controlled independent-review provenance path matches complete input binding",
      "all present Fact links have reviewed quality EXACT, PARTIAL or SCOPE_ONLY and correspond to actual field content; SCOPE_ONLY never counts as content",
      "claim and coverage applicability remain nonempty and downward-only",
      "ownership and each published bounded claim's own semantics are resolved and supported"
    ],
    "idempotence": "Same ai_id plus identical complete authoritative claims, support, Source, review, coverage and lifecycle is idempotent; any difference conflicts",
    "read_consistency": "A later reader takes one SQLite read transaction snapshot, checks every CURRENT coverage member is CURRENT, and projects claims and coverage from that snapshot; no mixed pre/post-commit view",
    "replacement": "Under write lock, stale every CURRENT coverage referring to a claim made STALE, including coverage outside the incoming overlay; otherwise reject atomically",
    "review_binding": {
      "behavior": [
        "type/key/target",
        "ownership mode and owner",
        "applicability",
        "participants/related subjects when present"
      ],
      "candidate": [
