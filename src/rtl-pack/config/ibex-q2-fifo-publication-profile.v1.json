        "build/source revision and closure digests",
        "scope ID and canonical envelope digest"
      ],
      "claim_set_digest": "SHA-256 of the canonical JSON array of sorted unique claim member IDs",
      "claims": [
        "AI ID and target/key/type/text/shape",
        "all structured fields/applicability/limitations",
        "each Fact ID, quality and field-level content relation",
